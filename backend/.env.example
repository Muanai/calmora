# Calmora Backend — Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL connection string (Neon DB)
# Format: postgresql+asyncpg://user:password@host/database?sslmode=require
DATABASE_URL=

# Google Gemini API Key
LLM_API_KEY=

# Gemini model name (default: gemini-2.0-flash-lite)
LLM_MODEL_NAME=gemini-2.0-flash-lite

# Gemini Embedding model for RAG (default: models/text-embedding-004, dimensi 768)
EMBEDDING_MODEL_NAME=models/text-embedding-004

# Number of RAG chunks to retrieve per query
RAG_TOP_K=4

# Admin API Key — untuk proteksi endpoint /api/v1/knowledge/ingest
# Set ke string random yang panjang
ADMIN_API_KEY=

# Clerk Authentication — JWKS endpoint for JWT verification
# Format: https://<your-clerk-domain>/.well-known/jwks.json
CLERK_JWKS_URL=
